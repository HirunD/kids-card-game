# Firebase web config — needed only for "Play online with a friend".
# Create a project at https://console.firebase.google.com, add a Web App,
# enable Realtime Database, then copy the values here into a file named
# ".env.local" (which is gitignored). Set the same vars in your Vercel /
# Netlify project settings for the deployed site.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The Realtime Database URL shown in the Firebase console after you enable it.
# Usually https://<project-id>-default-rtdb.firebaseio.com
# or a regional URL like https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# --- Ads (optional) -----------------------------------------------------------
# A single slim banner is pinned to the bottom of the screen. Leave these blank
# and nothing loads (in `npm start` you'll see a grey "Ad" placeholder instead).
# Get both values from https://www.google.com/adsense after your site is approved:
#   VITE_ADSENSE_CLIENT — your publisher id, looks like "ca-pub-0000000000000000"
#   VITE_ADSENSE_SLOT   — the ad unit id, a ~10-digit number
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
