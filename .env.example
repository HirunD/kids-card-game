# Firebase web config — needed only for "Play online with a friend".
# Create a project at https://console.firebase.google.com, add a Web App,
# enable Realtime Database, then copy the values here into a file named
# ".env.local" (which is gitignored). Set the same vars in your Vercel /
# Netlify project settings for the deployed site.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The Realtime Database URL shown in the Firebase console after you enable it.
# Usually https://<project-id>-default-rtdb.firebaseio.com
# or a regional URL like https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
